# MovieHarbor settings. Copy to .env and fill in what you use; every line is optional.
# Details: docs/desc/03-llm-and-tool-calling.md

# --- Local model (the default source): any OpenAI-compatible server ------------------------
# Ollama: http://127.0.0.1:11434/v1    LM Studio: http://127.0.0.1:1234/v1
# In Docker Compose the local model is the ollama service; these two lines are then ignored.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# The model id as the server lists it (GET <base url>/models),
# e.g. gemma4:e4b (Ollama) or google/gemma-3-12b (LM Studio). It must support tool calling
# (Ollama's gemma3 does not). Docker Compose picks the Ollama model with OLLAMA_MODEL:
# OLLAMA_MODEL=gemma4:e4b
LOCAL_LLM_MODEL=gemma4:e4b

# --- External API (the alternative): Gemma via OpenRouter ----------------------------------
# Key: https://openrouter.ai/keys. Without it the interface offers only the local model.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-26b-a4b-it
LLM_API_KEY=
# Optional: OpenRouter providers to try first, comma-separated (e.g. deepinfra,parasail)
LLM_PROVIDER_ORDER=

# --- Generation, shared by both sources ---------------------------------------------------
LLM_TEMPERATURE=0.7
# The largest valid answer (5 films with reasons) is sized to fit 1500; keep it at least ~1200.
LLM_MAX_TOKENS=1500
# Seconds to wait for one model answer: a local model on a CPU can take minutes.
LLM_TIMEOUT_S=300

# --- Trailers (optional): TMDB API key, https://www.themoviedb.org/settings/api -------------
# Without it the agent works without the show_trailer tool.
TMDB_API_KEY=
